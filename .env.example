# Configurações do projeto
# Copie este arquivo para .env.local e configure suas credenciais

# Supabase — projeto Vextria UB
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Monitoramento de erros (Sentry) — opcional.
# Deixe em branco para desativar. Em produção, cole o DSN do seu projeto Sentry.
VITE_SENTRY_DSN=