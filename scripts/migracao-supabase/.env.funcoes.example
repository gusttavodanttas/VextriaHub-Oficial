# Segredos das edge functions para o projeto NOVO. Copie para `.env.funcoes`
# (ignorado pelo git), preencha e rode o passo 5 do migrar.sh.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY são injetados
# automaticamente pelo Supabase — NÃO declarar aqui.
# Os valores do projeto antigo não podem ser lidos de volta no painel (só o
# hash): use os originais (Asaas, Google Cloud, Resend, OpenAI...).

APP_URL=https://www.vextriahub.com.br
ROBOT_SECRET=
RESEND_API_KEY=
ASAAS_API_KEY=
ASAAS_BASE_URL=
ASAAS_WEBHOOK_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_LIMITE_CHAMADAS_MES=
AI_LIMITE_VOZ_CARACTERES_MES=
PROCESSO_API_KEY=
BRIDGE_SECRET=
ZAP_BRIDGE_URL=
